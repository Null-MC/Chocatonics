    option.PHOTONICS_BLOCK_LIGHT_ENABLED=Block Light

    option.PHOTONICS_HAND_LIGHT_ENABLED=Hand Light

    option.PHOTONICS_TINTING=Tint Mode
    value.PHOTONICS_TINTING.0=Disabled
    value.PHOTONICS_TINTING.1=Block
    value.PHOTONICS_TINTING.2=Voxel

    screen.PHOTONICS_GI=Global Illumination

        option.PHOTONICS_GI_ENABLED=Enabled

        option.PHOTONICS_GI_BOUNCES=Bounces

        option.PHOTONICS_GI_BLOCK=Block Light

        option.PHOTONICS_GI_STEPS=Trace Steps

    screen.PHOTONICS_REFLECTIONS=Reflections

        option.PHOTONICS_REFLECT_ENABLED=Enabled

        option.PHOTONICS_REFLECT_BOUNCES=Bounces

        option.PHOTONICS_REFLECT_STEPS=Trace Steps

    screen.PHOTONICS_RESTIR=ReSTIR Options

        option.PHOTONICS_RESTIR_ENABLED=Enabled

        option.PHOTONICS_RESTIR_SOFT_SHADOWS=Soft Shadows

        option.PHOTONICS_RESTIR_DENOISE_PASSES=Denoise Passes
        option.PHOTONICS_RESTIR_DENOISE_PASSES.comment=The number of denoiser passes. A value of 0 disables denoising.

        option.PHOTONICS_RESTIR_FRAMES=Frame Count
        option.PHOTONICS_RESTIR_FRAMES.comment=The number of frames used for accumulation.

        option.PHOTONICS_RESTIR_INIT_COUNT=Initial Samples

        option.PHOTONICS_RESTIR_REUSE_COUNT=Reuse Samples

        option.PHOTONICS_RESTIR_REUSE_RADIUS=Reuse Radius
        suffix.PHOTONICS_RESTIR_REUSE_RADIUS=px


screen.MATERIALS=PBR Materials

    option.MAT_FORMAT=Format
    value.MAT_FORMAT.0=Automatic
    value.MAT_FORMAT.1=OldPbr
    value.MAT_FORMAT.2=LabPbr

    option.MAT_POROSITY_INTEGRATED=Integrated Porosity
    option.MAT_POROSITY_INTEGRATED.comment=Use shader-based porosity instead of resource pack values.

    screen.MAT_PARALLAX=Parallax

        option.MAT_PARALLAX_ENABLED=Enabled

        option.MAT_PARALLAX_DEPTH_WRITE=Depth-Write
        option.MAT_PARALLAX_DEPTH_WRITE.comment=POM adjusts the actual position, so screen space shadows can cast shadows on POM

        option.MAT_PARALLAX_DEPTH=Depth
        option.MAT_PARALLAX_DEPTH.comment=Increase to increase POM strength
        suffix.MAT_PARALLAX_DEPTH=%

        option.MAT_PARALLAX_ITERATIONS=Iterations
        option.MAT_PARALLAX_ITERATIONS.comment=Improves quality at grazing angles (reduces performance)

        option.MAT_PARALLAX_MAX_DIST=Max Distance
        option.MAT_PARALLAX_MAX_DIST.comment=Increases distance at which POM is calculated

        option.MAT_PARALLAX_GENERATED=Auto-Generate
        option.MAT_PARALLAX_GENERATED.comment=Can generate POM on any texturepack (may look weird in some cases)

    screen.MAT_EMISSION=Emission

        option.MAT_EMISSION_SCALE=Scale
        suffix.MAT_EMISSION_SCALE=x

        option.MAT_EMISSION_CURVE=Curve
        suffix.MAT_EMISSION_CURVE=%

    screen.MAT_SPECULAR=Specular

        option.MAT_SPECULAR_ENABLED=Enabled


screen.REFLECTIONS=Reflections

    option.REFLECTION_ENABLED=Enabled
    option.REFLECTION_ENABLED.comment=Can be really expensive at high resolutions/render quality, especially on ice

    option.REFLECTION_QUARTER_RES_DEPTH=Quarter-Res Tracing
    option.REFLECTION_QUARTER_RES_DEPTH.comment=Uses a quarter resolution depth buffer to raymarch screen space reflections, improves performance but may introduce artifacts

    option.REFLECTION_QUALITY=Quality
    option.REFLECTION_QUALITY.comment=Adjust the quality of the screenspace reflections.

    option.REFLECTION_ROUGH=Roughness Scattering
    option.REFLECTION_ROUGH.comment=Turns the roughness GGXVNDF ON. sizable performance impact, and introduces alot of noise.

    option.REFLECTION_ACCUMULATE=Accumulation


screen.TAA_OPTIONS=TAA

    option.TAA_ENABLED=Enabled

    option.TAA_RENDER_SCALE=Render Scale
    option.TAA_RENDER_SCALE.comment=Lowers render resolution and uses TAA to combine several lower resolution images (greatly improves performance).
    suffix.TAA_RENDER_SCALE=%

    option.TAA_BLEND_FACTOR=Blend Factor
    option.TAA_BLEND_FACTOR.comment=higher values = more flickering but sharper image, lower values = less flickering but the image will be blurrier

    option.TAA_CLOSEST_VELOCITY=Closest Velocity
    option.TAA_CLOSEST_VELOCITY.comment=improves edge quality in motion at the cost of performance

    option.TAA_NO_CLIP=No-Clip
    option.TAA_NO_CLIP.comment=Removes all anti-ghosting techniques used and creates a sharp image (good for still screenshots)
